digraph G {
  graph [rankdir=TB, nodesep=0.30, ranksep=0.34, bgcolor="white"];
  node  [shape=box, style="rounded,filled", fontname="SimSun", fontsize=10,
         fillcolor="#FFFFFF", color="#444444", penwidth=1.0, margin="0.20,0.09", width=4.8];
  edge  [color="#555555", arrowsize=0.75, penwidth=1.1];

  a [label="阶段零　数据审计（已完成）\n88.3% 成分仅单来源　｜　重复测量中位差 312.8 MPa\n成分梯度不连续（r=0.0148, p=0.296）　｜　同相/异相差异显著（p<0.0001）", fillcolor="#FDF0F0"];

  b [label="研究内容一　文献覆盖度的 PU 建模\n单来源 ⇒ 只有正例、无负例 ⇒ 标准 PU 设定\n↓\nElkan-Noto 校正：P(y=1|x) = g(x)/c\n↓\n对照：频次基线 ／ 不校正的普通分类器", fillcolor="#EDF3FA"];

  c [label="研究内容二　相结构条件化分层\nP(YS|x) = Σ P(φ|x) · P(YS|x,φ)\n↓\n相预测（分类）+ 相内回归，输出条件方差\n↓\n关键问题：「其他」相作独立相 ／ 作无标签样本", fillcolor="#F2F7EE"];

  d [label="研究内容三　同文献成对排序约束\n绝对回归在高噪声下不可行，改用相对次序\n↓\n合页损失 + 噪声阈值过滤（阈值由 312.8 MPa 定）\n↓\n对照：纯回归 ／ 含 与 不含 阈值两版", fillcolor="#FBF3EC"];

  e [label="集成：合金方向推荐原型\n候选排序 ＋ 覆盖度提示 ＋ 预测区间", fillcolor="#EFEFEF", penwidth=1.6];

  f [label="评测：留一元素体系交叉验证\n（报告置信区间，非单点数值）", shape=note, fillcolor="#FFFDF0", fontsize=9];

  a -> b -> c -> d -> e;
  f -> e [style=dashed, label="  评测", fontsize=9];
}
