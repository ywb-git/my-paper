digraph G {
  graph [rankdir=TB, nodesep=0.28, ranksep=0.32, bgcolor="white"];
  node  [shape=box, style="rounded,filled", fontname="SimSun", fontsize=10,
         fillcolor="#FFFFFF", color="#444444", penwidth=1.0, margin="0.18,0.08", width=5.0];
  edge  [color="#555555", arrowsize=0.75, penwidth=1.1];

  a [label="阶段一　工具链验证与数据准备\nhea-bench 2.9.0（MIT）· heacalculator 2.2.0 · pycalphad 0.11.2\n产出：三工具在 BCC/B2 体系的实际可用性、CALPHAD 数据库覆盖范围", fillcolor="#FDF0F0"];

  b [label="研究内容一　判据一致性对照\n同一成分集：描述符判据（多模型投票）  vs  CALPHAD 相平衡\n↓\n一致率 · Cohen κ · 分歧在成分空间的分布\n↓\n产出：简化判据的适用边界", fillcolor="#EDF3FA"];

  c [label="研究内容二　带置信度的奖励构造\n置信度 = 多模型一致性 ＋ 成分覆盖度 ＋ 与 CALPHAD 一致性\n↓\n样本三分：高置信（正例）／低置信（降权）／冲突（单独分析）\n↓\n偏好对：高置信正例  vs  低置信负例", fillcolor="#F2F7EE"];

  d [label="研究内容三　样本选择与本地对齐（主算法切入）\nQwen3 底座（4B–8B）＋ LoRA/QLoRA ＋ DPO\n↓\n选择规则：学生薄弱度 ＋ 约束覆盖度 － 重复惩罚（迭代更新）\n↓\n对照：随机 ／ 仅薄弱 ／ 仅多样 ／ 全量（上界）", fillcolor="#FBF3EC"];

  e [label="集成：本地配方助手原型\n输入 成分＋修改要求 → 候选 ＋ 判据依据 ＋ 置信度", fillcolor="#EFEFEF", penwidth=1.6];

  f [label="评测：按元素体系分组划分\n约束满足率 · 判据通过率 · 与教师模型差距 · 成本延迟", shape=note, fillcolor="#FFFDF0", fontsize=9];

  a -> b -> c -> d -> e;
  f -> e [style=dashed, label="  评测", fontsize=9];
}
