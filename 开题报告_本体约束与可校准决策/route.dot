digraph G {
  graph [rankdir=TB, nodesep=0.30, ranksep=0.34, bgcolor="white", dpi=180];
  node [shape=box, style="rounded,filled", fontname="SimSun", fontsize=11,
        fillcolor="#FFFFFF", color="#444444", penwidth=1.0, margin="0.22,0.12", width=6.6];
  edge [color="#555555", arrowsize=0.75, penwidth=1.1];

  a [label="数据与标签审计\n固态氧化物子集 · 固定参考库 R 与候选分布 Q\n按论文 / 目标 / 重复路线关联分组；库内未匹配不等于实验失败", fillcolor="#EDF3FA"];
  b [label="冻结候选生成与底座评分\nSchema 规范化与约束审计 · 历史检索证据 · 逻辑回归 / 类型化模型\n隐藏参考不进入模型；热力学仅作特征，不作匹配真值", fillcolor="#EDF3FA"];
  c [label="校准策略比较（主研究）\nS1 未校准 / S2 全局 / S3 独立分组 / S4 部分池化\n受控标签缺失与观测偏置对照；同候选、同标签预算", fillcolor="#F2F7EE"];
  d [label="独立保形与偏移评估\n训练 → 开发 → 概率拟合 → 独立保形 → 最终测试\n关联组随机抽样：有条件的边际覆盖；时序测试：经验表现", fillcolor="#FBF3EC"];
  e [label="输出与结论边界\n候选路线 ＋ 文献匹配概率 ＋ 标签预测集 / 拒答\n概率误差 · 集合大小 · 模拟文献核验效用\n不等同于真实合成成功率或单条概率置信区间", fillcolor="#EFEFEF", penwidth=1.6];
  a -> b -> c -> d -> e;
}
