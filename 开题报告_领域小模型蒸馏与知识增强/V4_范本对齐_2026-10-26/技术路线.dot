digraph G {
  graph [rankdir=TB, bgcolor="white", nodesep=0.3, ranksep=0.32, dpi=180];
  node [shape=box, style="rounded,filled", fontname="SimSun", fontsize=11,
        fillcolor="#FFFFFF", color="#444444", margin="0.2,0.13", width=6.5];
  edge [color="#555555", arrowsize=0.7];
  a [label="① 文献解析与条件字段抽取\nPDF → 结构化文本（MinerU）→ 抽取成分、性能、测试温度、制备工艺、试验类型\n缺失字段标注为未知，不默认填充", fillcolor="#EDF3FA"];
  b [label="② 条件元组绑定与本地知识库构建\n每条性能记录绑定测试温度、制备工艺、试验类型三类条件\nMPEA 基础库 + 文献补充库，统一记录结构与来源标识", fillcolor="#EDF3FA"];
  c [label="③ 条件感知检索（研究内容一）\n按语义与条件召回候选 → 规则判定相符／冲突／未知\n规则可判定约 89%＋7%，冲突样本占约 58%", fillcolor="#F2F7EE"];
  d [label="④ 条件冲突处置与答案生成（研究内容二）\n规则处置基线 vs 小模型处置（经过程示范蒸馏）\n相符作直接支持／冲突降级或排除／未知标注不确定\n答案强制标注所依据记录的条件", fillcolor="#FBF3EC"];
  e [label="⑤ 评估与归因\n分问题类型答案正确率；按有无干扰项分层增益\n错误三类归因：检索未命中／条件误用／生成错误\nOracle 设置分离检索、条件处理、生成三环节", fillcolor="#EFEFEF", penwidth=1.5];
  a -> b -> c -> d -> e;
}
